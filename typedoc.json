{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "dist/index.d.ts",
    "dist/vite-plugin.d.ts"
  ],
  "tsconfig": "tsconfig.docs.json",
  "out": "docs/api",
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "hideGenerator": true,
  "disableSources": true,
  "gitRevision": "main"
}
