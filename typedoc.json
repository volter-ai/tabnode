{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/vite-plugin.ts"],
  "tsconfig": "tsconfig.build.json",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "hideGenerator": true,
  "disableSources": true,
  "gitRevision": "main"
}
