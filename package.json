{
  "name": "@volter/tabnode",
  "version": "0.5.26",
  "description": "Node's own library, in a browser tab.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "node",
    "browser",
    "runtime",
    "virtual-filesystem",
    "vite",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/tabnode.git"
  },
  "homepage": "https://github.com/volter-ai/tabnode#readme",
  "bugs": {
    "url": "https://github.com/volter-ai/tabnode/issues"
  },
  "author": "Aaron <aaron@volter.ai>",
  "engines": {
    "node": ">=20.19.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "default": "./dist/vite-plugin.mjs"
    }
  },
  "files": [
    "src",
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:lib": "vite build --config vite.lib.config.js && tsc -p tsconfig.build.json",
    "docs:api": "typedoc",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "acorn": "^8.15.0",
    "amaro": "1.1.0",
    "brotli": "^1.3.3",
    "brotli-wasm": "^3.0.1",
    "buffer": "6.0.3",
    "comlink": "^4.4.2",
    "just-bash": "^2.14.5",
    "pako": "^2.1.0",
    "resolve.exports": "^2.0.3",
    "sha.js": "2.4.12",
    "vite-plugin-wasm": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/pako": "^2.0.4",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
