{
  "name": "tabnode",
  "version": "0.2.14-volter.87",
  "description": "Node's own library, in a browser tab.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "node",
    "browser",
    "runtime",
    "virtual-filesystem",
    "vite",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/volter-ai/tabnode.git"
  },
  "homepage": "https://github.com/volter-ai/tabnode#readme",
  "bugs": {
    "url": "https://github.com/volter-ai/tabnode/issues"
  },
  "author": "Aaron <aaron@volter.ai>",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite-plugin.d.ts",
        "default": "./dist/vite-plugin.mjs"
      },
      "require": {
        "types": "./dist/vite-plugin.d.ts",
        "default": "./dist/vite-plugin.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build:lib": "vite build --config vite.lib.config.js && (tsc -p tsconfig.build.json || true)",
    "build:types": "tsc --project tsconfig.build.json",
    "build:publish": "npm run build:lib && npm run build:types",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "acorn": "^8.15.0",
    "brotli": "^1.3.3",
    "brotli-wasm": "^3.0.1",
    "buffer": "6.0.3",
    "comlink": "^4.4.2",
    "just-bash": "^2.14.5",
    "pako": "^2.1.0",
    "resolve.exports": "^2.0.3",
    "sha.js": "2.4.12",
    "vite-plugin-wasm": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@types/pako": "^2.0.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
